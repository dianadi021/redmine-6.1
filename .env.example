# ==============================================================================
# Environment Configuration Template: Redmine 6.1 Docker Stack
# ==============================================================================
# Salin file ini menjadi .env sebelum menjalankan container:
#   cp .env.example .env
# ==============================================================================

# Domain & Jaringan
DOMAIN_NAME=<DNS_VPS>
REDMINE_PORT=10083

# Kredensial Database PostgreSQL
POSTGRES_USER=redmine
POSTGRES_PASSWORD=generate_strong_postgres_password_here
POSTGRES_DB=redmine_production

# Rails Secret Key Base (Generate dengan: openssl rand -hex 64)
REDMINE_SECRET_KEY_BASE=generate_with_openssl_rand_hex_64_here

# Konfigurasi SMTP Notifikasi
REDMINE_SMTP_HOST=mail.<DNS_VPS>
REDMINE_SMTP_PORT=587
REDMINE_SMTP_USER=notify@<DNS_VPS>
REDMINE_SMTP_PASSWORD=generate_strong_smtp_password_here
REDMINE_SMTP_STARTTLS=true
REDMINE_SMTP_AUTHENTICATION=plain

# Zona Waktu
TZ=Asia/Jakarta
